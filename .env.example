# 复制成 .env 后填写真实值（.env 不要提交到 git / 不要发给别人）

# --- 发布：Buffer（必需）---
# Buffer 后台 → Settings → API → 创建 personal API key
BUFFER_TOKEN=

# --- 抓取：web 模式（默认）不需要任何凭证 ---

# --- 抓取：telethon 用户会话模式（频道转私有 / 要秒级时用）---
# https://my.telegram.org/apps 免费申请
TG_API_ID=
TG_API_HASH=
TG_PHONE=+8613800000000

# --- 翻译：provider=llm 时才需要 ---
OPENAI_API_KEY=

# --- 发布：target=http 时才需要 ---
X_POSTER_TOKEN=
